{
  "meta": {
    "protocol_name": "国网三统一模块通讯协议",
    "protocol_id": "sg_unified_v107",
    "version": "V107",
    "standard": "电动汽车非车载传导式充电机功率控制模块与充电模块通信协议",
    "baud_rate": 125000,
    "frame_format": "CAN_2.0B_EXTENDED",
    "roles": {"power_control": "功率控制模块", "charge_module": "充电模块"}
  },
  "can_id_schema": {
    "total_bits": 29,
    "fields": [
      {"name": "priority", "bit_start": 26, "bit_len": 3, "description": "优先权"},
      {"name": "edp", "bit_start": 25, "bit_len": 1, "fixed_value": 0},
      {"name": "dp", "bit_start": 24, "bit_len": 1, "fixed_value": 0},
      {"name": "pf", "bit_start": 16, "bit_len": 8, "description": "PDU格式"},
      {"name": "ps", "bit_start": 8, "bit_len": 8, "description": "目标地址"},
      {"name": "sa", "bit_start": 0, "bit_len": 8, "description": "源地址"}
    ],
    "message_identifier": "pf",
    "identifier_field": "pf"
  },
  "addresses": {
    "POWER_CONTROL": {"value": 160, "hex": "0xA0", "name": "功率控制模块", "range": "0xA0~0xAE", "description": "默认地址，可配置"},
    "POWER_CONTROL_BROADCAST": {"value": 175, "hex": "0xAF", "name": "功率控制模块广播"},
    "CHARGE_MODULE": {"value": 32, "hex": "0x20", "name": "充电模块", "range": "0x20~0x9E", "description": "地址可配置"},
    "MODULE_BROADCAST": {"value": 159, "hex": "0x9F", "name": "充电模块广播"}
  },
  "fixed_group_map": [
    {"range": "0x80~0x87", "group": 1},
    {"range": "0x88~0x8F", "group": 2},
    {"range": "0x90~0x97", "group": 3},
    {"range": "0x98~0x9E", "group": 4},
    {"range": "0x60~0x67", "group": 5},
    {"range": "0x68~0x6F", "group": 6},
    {"range": "0x70~0x77", "group": 7},
    {"range": "0x78~0x7F", "group": 8}
  ],
  "encoding_rules": {
    "default_byte_order": "little_endian",
    "undefined_bit_fill": 1
  },
  "transport": {
    "type": "sg_sequence",
    "applies_to_pf": [128, 129, 130, 131, 142, 143],
    "max_frames": 32,
    "description": "数据域超 8 字节时按自定义序号分帧: 首帧 byte0=序号(1), byte1=总帧数, byte2-3=有效数据长度(LE), byte4-7=数据01-04; 后续帧 byte0=序号, byte1-7=数据; 末帧在数据后为 2 字节累加和校验, 余位填 0。PF 沿用报文自身 PF, 不使用 J1939 TP (0xEB/0xEC)"
  },
  "message_matcher": {
    "type": "pf_based",
    "match_field": "pf"
  },
  "message_groups": [
    {"name": "固定分组遥控", "messages": ["RC_CMD_FIXED", "RC_RESP_FIXED"]},
    {"name": "动态分组", "messages": ["GROUP_SET", "GROUP_RESP", "RC_CMD_DYN", "RC_RESP_DYN"]},
    {"name": "遥信遥测", "messages": ["TELEMETRY"]},
    {"name": "心跳", "messages": ["HEARTBEAT_TX", "HEARTBEAT_RX"]},
    {"name": "定值", "messages": ["PARAM_SET", "PARAM_RESP", "PARAM_QUERY", "PARAM_QUERY_RESP"]},
    {"name": "程序在线更新", "messages": ["UPG_HEARTBEAT", "UPG_HEARTBEAT_RESP", "UPG_START_DOWNLOAD", "UPG_START_DOWNLOAD_RESP", "UPG_REQ_RANGE", "UPG_REQ_RANGE_RESP1", "UPG_REQ_RANGE_RESP2", "UPG_START_PACK", "UPG_START_PACK_RESP", "UPG_SEND_DATA", "UPG_FINISH_PACK", "UPG_FINISH_PACK_RESP", "UPG_VERIFY", "UPG_VERIFY_RESP", "UPG_RESET", "UPG_RESET_RESP"]},
    {"name": "调试信息", "messages": ["DEBUG_DOWN", "DEBUG_UP"]}
  ],
  "messages": [
    {
      "name": "遥控命令（固定分组）",

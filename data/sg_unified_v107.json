        {"name": "输出电压范围", "byte_start": 1, "length": 1, "bit_start": 4, "bit_len": 1, "data_type": "bits", "enum": {"0": "低压段(200-500V)", "1": "高压段(500-950V)"}, "required": true},
        {"name": "功分接触器", "byte_start": 1, "length": 1, "bit_start": 5, "bit_len": 1, "data_type": "bits", "enum": {"0": "分断", "1": "闭合"}, "required": true},
        {"name": "主接触器", "byte_start": 1, "length": 1, "bit_start": 6, "bit_len": 1, "data_type": "bits", "enum": {"0": "分断", "1": "闭合"}, "required": true},
        {"name": "分组编码", "byte_start": 2, "length": 1, "data_type": "int_le", "description": "目的地址为充电模块广播地址时生效，bit0~bit7 对应第1~8组选择", "required": false},
        {"name": "给定电压", "byte_start": 3, "length": 2, "data_type": "int_le", "resolution": 0.1, "unit": "V", "range": [0, 1000], "required": true},
        {"name": "给定电流", "byte_start": 5, "length": 2, "data_type": "int_le", "resolution": 0.01, "unit": "A", "range": [0, 600], "required": true},
        {"name": "电池电压", "byte_start": 7, "length": 2, "data_type": "int_le", "resolution": 0.1, "unit": "V", "range": [0, 1000], "required": true}
      ]
    },
    {
      "name": "遥控命令应答（固定分组）",
